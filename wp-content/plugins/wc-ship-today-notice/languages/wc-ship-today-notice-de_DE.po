#. Plugin Name of the plugin
#: wc-ship-today-notice.php
msgid "Powiadomienie o wysyłce dziś"
msgstr "Benachrichtigung über heutigen Versand"

#. Description of the plugin
#: wc-ship-today-notice.php
msgid "Wyświetla powiadomienie \"wyślij dziś, jeśli zamówienie zostanie złożone przed upływem terminu\". Użycie przez shortcode [ship_today_notice]."
msgstr "Zeigt den Hinweis \"Versand heute, wenn die Bestellung vor Ablauf der Frist aufgegeben wird\" an. Verwendung über den Shortcode [ship_today_notice]."

#. Author of the plugin
#: wc-ship-today-notice.php
msgid "MS-M.pl, Studio Zaiste"
msgstr "MS-M.pl, Studio Zaiste"

