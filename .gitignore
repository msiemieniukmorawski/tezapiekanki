# TeZapiekanki: repository of our own code inside the WordPress directory.
#
# Whitelist: ignore everything (WP core, Woodmart, third-party plugins,
# uploads, cache, backups, wp-config.php with credentials) and allow only
# the code and docs we change ourselves.


/*

# Project docs and E2E tests
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/.claude/
/.claude/*
!/.claude/doc/
!/.claude/tests/
/.claude/settings.local.json
# old copy of the plugin with its own .git (the current one is in wp-content/plugins)
/.claude/doc/wc-ship-today-notice/

!/wp-content/
/wp-content/*

# Child theme
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/woodmart-child/

# Own plugins (both were separate repos until 2026-10-28; tezapiekanki history is merged in,
# the old wc-ship-today-notice .git is in backups/2026-10-28-wc-ship-today-notice-git)
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/tezapiekanki/
!/wp-content/plugins/wc-ship-today-notice/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.log
*.swp
.idea/
.vscode/
node_modules/
